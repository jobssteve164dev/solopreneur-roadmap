{
  "name": "solopreneur-roadmap",
  "displayName": "SoloMap - AI Coding Agent Roadmap",
  "description": "AI coding agent cockpit for solo developers. Run Claude Code, Codex, Cursor Agent and other local agents, keep sessions organized, and turn scattered AI chats into a Git-friendly project roadmap. / 面向独立开发者的 AI 编码智能体驾驶舱：运行 Claude Code、Codex、Cursor Agent 等本地智能体，整理会话，并把零散 AI 对话沉淀为 Git 友好的项目路线图。",
  "version": "0.0.424",
  "publisher": "SZLK",
  "icon": "resources/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jobssteve164dev/solopreneur-roadmap.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "ai-agent",
    "ai-coding",
    "ai-assistant",
    "agentic-workflow",
    "claude-code",
    "cursor-agent",
    "local-ai",
    "solopreneur",
    "roadmap",
    "git-friendly",
    "chat",
    "agent",
    "workflow",
    "project-planning",
    "productivity"
  ],
  "activationEvents": [
    "onView:solopreneur.sidebar",
    "onCommand:solopreneur.showRoadmap",
    "onCommand:solopreneur.showStrategyPyramid",
    "onCommand:solopreneur.refreshProjectGrowthData",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "solopreneur.showRoadmap",
        "title": "SoloMap: Show AI Roadmap",
        "category": "SoloMap"
      },
      {
        "command": "solopreneur.showStrategyPyramid",
        "title": "SoloMap: Show Strategy Pyramid",
        "category": "SoloMap"
      },
      {
        "command": "solopreneur.refreshProjectGrowthData",
        "title": "SoloMap: Refresh Project Growth Data",
        "category": "SoloMap"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "solopreneur-sidebar-container",
          "title": "SoloMap",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "solopreneur-sidebar-container": [
        {
          "type": "webview",
          "id": "solopreneur.sidebar",
          "name": "SoloMap"
        }
      ]
    },
    "configuration": {
      "title": "SoloMap Settings",
      "properties": {
        "solopreneur.cliPath": {
          "type": "string",
          "default": "agy",
          "description": "The command name or absolute path of your local Agent CLI executable, such as agy, codex, claude, or opencode."
        },
        "solopreneur.language": {
          "type": "string",
          "default": "zh",
          "enum": [
            "zh",
            "en"
          ],
          "description": "The display language used by SoloMap webviews."
        },
        "solopreneur.globalPrompt": {
          "type": "string",
          "default": "",
          "description": "Default instructions injected into every SoloMap Agent task conversation."
        },
        "solopreneur.globalDataPath": {
          "type": "string",
          "default": "",
          "description": "Directory path used for SoloMap cross-project data. SoloMap stores .solomap-global data here; if a parent directory is provided, .solomap-global is created inside it."
        },
        "solopreneur.reviewerCliPath": {
          "type": "string",
          "default": "",
          "description": "Optional secondary Agent CLI used for read-only review after task runs. If empty, SoloMap uses the main Agent CLI."
        },
        "solopreneur.collaborationReviewMode": {
          "type": "string",
          "default": "high_risk",
          "enum": [
            "off",
            "high_risk",
            "all"
          ],
          "description": "Controls when SoloMap runs a secondary read-only Agent review after a task run."
        },
        "solopreneur.automationTasks": {
          "type": "object",
          "default": {
            "focusMinutes": 25,
            "scheduledTasks": [],
            "triggers": {
              "completed": {
                "notify": false,
                "sound": false,
                "retry": false,
                "prompt": ""
              },
              "failed": {
                "notify": false,
                "sound": false,
                "retry": false,
                "prompt": ""
              },
              "stopped": {
                "notify": false,
                "sound": false,
                "retry": false,
                "prompt": ""
              },
              "focus_time": {
                "notify": false,
                "sound": false,
                "retry": false,
                "prompt": ""
              },
              "scheduled_time": {
                "notify": false,
                "sound": false,
                "retry": false,
                "timeOfDay": "09:00",
                "prompt": ""
              }
            }
          },
          "description": "Optional SoloMap automation tasks. Actions are disabled by default and run after task state updates without blocking the main task."
        },
        "solopreneur.telegramEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Telegram remote control and status notifications. / 启用 Telegram 远程控制与状态通知。"
        },
        "solopreneur.telegramBotToken": {
          "type": "string",
          "default": "",
          "description": "Telegram Bot Token from @BotFather. / 从 @BotFather 获得的 Telegram Bot Token。"
        },
        "solopreneur.telegramChatId": {
          "type": "string",
          "default": "",
          "description": "Your Telegram Chat ID for receiving alerts and authorization requests. / 用于接收警告与授权请求的 Telegram Chat ID。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test test/*.test.js",
    "solomap:experience": "node resources/tools/solomap-experience.cjs",
    "validate:scheduled-tasks": "node resources/tools/validate-scheduled-tasks.cjs",
    "openvsx:rank": "node scripts/open-vsx-rank.cjs",
    "package:vsix": "node scripts/package-vsix.cjs",
    "verify:vsix": "node scripts/verify-vsix-package.cjs",
    "install:local-dev": "node scripts/install-local-dev.js",
    "build-webview": "echo 'No webview build configured yet'"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.38",
    "c8": "12.0.0",
    "dependency-cruiser": "^16.10.4",
    "istanbul-lib-coverage": "3.2.2",
    "papaparse": "^5.4.1",
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/node": "^16.18.34",
    "@types/papaparse": "^5.3.7",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.5"
  }
}
