{
  "name": "solopreneur-roadmap",
  "displayName": "Solopreneur AI Roadmap & Agent Orchestrator",
  "description": "Visual AI Roadmaps and Agent orchestration for solopreneurs in VS Code.",
  "version": "0.0.11",
  "publisher": "SZLK",
  "icon": "resources/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jobssteve164dev/solopreneur-roadmap.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:solopreneur.sidebar",
    "onCommand:solopreneur.showRoadmap"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "solopreneur.showRoadmap",
        "title": "Solopreneur: Show AI Roadmap",
        "category": "Solopreneur"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "solopreneur-sidebar-container",
          "title": "Solopreneur",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "solopreneur-sidebar-container": [
        {
          "type": "webview",
          "id": "solopreneur.sidebar",
          "name": "Solopreneur Roadmap"
        }
      ]
    },
    "configuration": {
      "title": "Solopreneur AI Roadmap Settings",
      "properties": {
        "solopreneur.apiProvider": {
          "type": "string",
          "default": "Gemini",
          "enum": [
            "Gemini",
            "OpenAI",
            "VS Code Copilot (Native)"
          ],
          "description": "The AI provider used to generate visual roadmaps."
        },
        "solopreneur.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your API key for the selected standalone AI provider (Gemini or OpenAI).",
          "scope": "application"
        },
        "solopreneur.cliPath": {
          "type": "string",
          "default": "antigravity-cli",
          "description": "The command name or absolute path of your local Codex / Antigravity CLI executable."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test test/*.test.js",
    "build-webview": "echo 'No webview build configured yet'"
  },
  "dependencies": {
    "papaparse": "^5.4.1",
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^16.18.34",
    "@types/papaparse": "^5.3.7",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.5"
  }
}
