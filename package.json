{
  "name": "solopreneur-roadmap",
  "displayName": "SoloMap - Local AI Agent Cockpit & Coding Roadmap Assistant",
  "description": "Stop losing momentum in scattered AI chats. SoloMap is a local AI Agent cockpit and coding roadmap assistant for solo developers. / 别让项目迷失在零散 AI 对话里。SoloMap 是专为独立开发者打造的本地 AI Agent 驾驶舱与编码路线图助手。",
  "version": "0.0.238",
  "publisher": "SZLK",
  "icon": "resources/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jobssteve164dev/solopreneur-roadmap.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "ai-agent",
    "ai-coding",
    "ai-assistant",
    "agentic-workflow",
    "claude-code",
    "cursor-agent",
    "local-ai",
    "solopreneur",
    "roadmap",
    "git-friendly",
    "chat",
    "agent",
    "workflow",
    "project-planning",
    "productivity"
  ],
  "activationEvents": [
    "onView:solopreneur.sidebar",
    "onCommand:solopreneur.showRoadmap",
    "onCommand:solopreneur.showStrategyPyramid",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "solopreneur.showRoadmap",
        "title": "SoloMap: Show AI Roadmap",
        "category": "SoloMap"
      },
      {
        "command": "solopreneur.showStrategyPyramid",
        "title": "SoloMap: Show Strategy Pyramid",
        "category": "SoloMap"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "solopreneur-sidebar-container",
          "title": "SoloMap",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "solopreneur-sidebar-container": [
        {
          "type": "webview",
          "id": "solopreneur.sidebar",
          "name": "SoloMap"
        }
      ]
    },
    "configuration": {
      "title": "SoloMap Settings",
      "properties": {
        "solopreneur.cliPath": {
          "type": "string",
          "default": "agy",
          "description": "The command name or absolute path of your local Agent CLI executable, such as agy, codex, claude, or opencode."
        },
        "solopreneur.language": {
          "type": "string",
          "default": "zh",
          "enum": [
            "zh",
            "en"
          ],
          "description": "The display language used by SoloMap webviews."
        },
        "solopreneur.globalPrompt": {
          "type": "string",
          "default": "",
          "description": "Default instructions injected into every SoloMap Agent task conversation."
        },
        "solopreneur.globalDataPath": {
          "type": "string",
          "default": "",
          "description": "Directory path used for SoloMap cross-project data. SoloMap stores .solomap-global data here; if a parent directory is provided, .solomap-global is created inside it."
        },
        "solopreneur.reviewerCliPath": {
          "type": "string",
          "default": "",
          "description": "Optional secondary Agent CLI used for read-only review after task runs. If empty, SoloMap uses the main Agent CLI."
        },
        "solopreneur.collaborationReviewMode": {
          "type": "string",
          "default": "high_risk",
          "enum": [
            "off",
            "high_risk",
            "all"
          ],
          "description": "Controls when SoloMap runs a secondary read-only Agent review after a task run."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test test/*.test.js",
    "solomap:experience": "node resources/tools/solomap-experience.cjs",
    "install:local-dev": "node scripts/install-local-dev.js",
    "build-webview": "echo 'No webview build configured yet'"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.38",
    "papaparse": "^5.4.1",
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^16.18.34",
    "@types/papaparse": "^5.3.7",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.5"
  }
}
