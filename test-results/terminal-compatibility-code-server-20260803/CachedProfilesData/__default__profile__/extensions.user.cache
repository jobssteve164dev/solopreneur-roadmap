iewItem =~ /^skill/","group":"3_info"},{"command":"skills-sh.updateSingleSkill","when":"view == skills-sh.installedSkills && viewItem =~ /^skill_updatable/","group":"inline"},{"command":"skills-sh.updateAllSkills","when":"view == skills-sh.installedSkills && viewItem == updatesGroup","group":"inline"},{"command":"skills-sh.addToManifest","when":"view == skills-sh.installedSkills && viewItem =~ /^skill/ && !(viewItem =~ /manifest/)","group":"inline"},{"command":"skills-sh.addToManifest","when":"view == skills-sh.installedSkills && viewItem =~ /^skill/ && !(viewItem =~ /manifest/)","group":"2_actions"},{"command":"skills-sh.removeFromManifest","when":"view == skills-sh.installedSkills && viewItem =~ /^skill.*_manifest$/","group":"inline"},{"command":"skills-sh.removeFromManifest","when":"view == skills-sh.installedSkills && viewItem =~ /^skill.*_manifest$/","group":"2_actions"}]},"viewsWelcome":[{"view":"skills-sh.installedSkills","contents":"No agent skills detected.\n\nSkills are scanned from the skill directories of all supported agents — Claude Code, Cursor, Windsurf, GitHub Copilot, Codex, Cline, and more.\n\nEach skill must be a folder containing a SKILL.md file.\n\n[Browse Marketplace](command:skills-sh.openMarketplace)\n[Open Settings](command:skills-sh.openSettings)","when":"skills-sh.noSkillsFound"}],"configuration":[{"title":"Skills.sh","order":1,"properties":{"skills-sh.installScope":{"type":"string","enum":["global","project","ask"],"enumDescriptions":["Install to ~/.agents/skills/ — available in every project (recommended)","Install to the current workspace for team sharing via git","Prompt you to choose each time"],"default":"global","scope":"window","markdownDescription":"Controls where skills are installed by default.\n- `global` — installs to your home directory (`~/.agents/skills/`), making skills available in every project. This is the recommended default.\n- `project` — installs to the current workspace for team sharing via git.\n- `ask` — prompts you to choose each time."},"skills-sh.claudeLaunchTarget":{"type":"string","enum":["terminal","extension"],"default":"terminal","enumDescriptions":["Open Claude in VS Code terminal (works without Claude Code extension)","Open Claude in Claude Code editor panel (requires anthropic.claude-code extension)"],"scope":"window","markdownDescription":"How to open Claude when using **Launch Claude with Skill** from the context menu.\n- `terminal` — runs the Claude CLI in a new VS Code terminal (works without any extra extensions).\n- `extension` — opens the Claude Code editor panel (requires the `anthropic.claude-code` extension)."},"skills-sh.confirmBeforeInstall":{"type":"boolean","default":true,"scope":"window","markdownDescription":"Show a confirmation dialog before installing or uninstalling skills. Disable this to install immediately without prompts."},"skills-sh.activeAgents":{"type":"array","default":["canonical","claude-code","cursor","windsurf","github-copilot","codex","roo","gemini-cli","trae","kiro","continue"],"items":{"type":"string","enum":["canonical","claude-code","cursor","windsurf","github-copilot","codex","roo","gemini-cli","trae","kiro","continue"]},"uniqueItems":true,"scope":"window","markdownDescription":"Which AI agents to scan for installed skills. Only selected agents' skill directories will be included. Remove agents you don't use to reduce noise.\n\nAgent IDs: `canonical` (skills.sh), `claude-code`, `cursor`, `windsurf`, `github-copilot`, `codex`, `roo`, `gemini-cli`, `trae`, `kiro`, `continue`."}}},{"title":"Marketplace","order":2,"properties":{"skills-sh.categories":{"type":"array","default":["react","next","supabase","testing","ai","database","auth","css"],"items":{"type":"string"},"scope":"window","markdownDescription":"Filter chips displayed above the marketplace skill list. Click a chip to quickly search for skills in that category. Add or remove entries to customize the filters to your interests."}}},{"title":"Behavior","order":3,"properties":{"skills-sh.autoRefreshOnFocus":{"type":"boolean","default":true,"scope":"window","markdownDescription":"Automatically re-scan your skills directories when the VS Code window regains focus. Keeps the installed skills list up to date when you install or remove skills outside of VS Code (e.g., via `npx skills add` in a terminal)."},"skills-sh.scanWsl":{"type":"boolean","default":true,"scope":"window","markdownDescription":"**Windows only.** Also scan **running** WSL distros for installed skills, shown as a collapsed `WSL: <distro>` group. Skills installed inside WSL (e.g. `npx skills add` run in a WSL terminal) live on a separate filesystem the Windows host can't otherwise see. WSL skills that resolve (via symlink) into this machine's own `~/.agents` store are recognized as the same skills and hidden automatically — only genuinely WSL-local skills are listed. Only running distros are scanned to avoid auto-starting stopped ones. Disable to skip WSL entirely."},"skills-sh.checkUpdatesOnStartup":{"type":"boolean","default":true,"scope":"window","markdownDescription":"Check for available skill updates each time VS Code starts. When updates are found, a notification appears with an option to update all. Disable this to check manually via **Check for Updates** in the Command Palette."},"skills-sh.promptSkillsJson":{"type":"boolean","default":true,"scope":"window","markdownDescription":"Prompt to create a `skills.json` manifest when opening a project that has installed skills but no manifest file. The manifest lets you share recommended skills with your team — teammates can run **Install from skills.json** to sync."},"skills-sh.showNotifications":{"type":"string","enum":["all","errors","none"],"enumDescriptions":["Show all notifications (installs, updates, errors)","Only show error notifications","Suppress all notifications"],"default":"all","scope":"window","markdownDescription":"Control which toast notifications the extension displays.\n- `all` — shows notifications for installs, updates, and errors.\n- `errors` — only shows error notifications.\n- `none` — suppresses all notifications."}}}]},"scripts":{"vscode:prepublish":"node esbuild.config.mjs --production","build":"node esbuild.config.mjs","watch":"node esbuild.config.mjs --watch","package":"vsce package","lint":"eslint src/","version":"node scripts/stamp-changelog.mjs","test":"vitest run","test:watch":"vitest","test:coverage":"vitest run --coverage"},"devDependencies":{"@types/node":"^20.11.0","@types/vscode":"^1.93.0","@vitest/coverage-v8":"^2.0.0","@vscode/vsce":"^3.2.0","esbuild":"^0.24.0","happy-dom":"^20.7.0","typescript":"^5.5.0","vitest":"^2.0.0"},"dependencies":{"gray-matter":"^4.0.3","marked":"^15.0.0"}},"location":{"$mid":1,"path":"/home/ubuntu/.local/share/code-server/extensions/abelmak.skills-sh-0.3.1-universal","scheme":"file"},"isBuiltin":false,"targetPlatform":"universal","publisherDisplayName":"AbelMak","metadata":{"isApplicationScoped":false,"isMachineScoped":false,"isBuiltin":false,"installedTimestamp":1783121437642,"pinned":false,"source":"gallery","id":"a1395d33-d5bb-40cb-9df9-c7535021e603","publisherId":"3e4dad01-1648-4ef4-87fc-76c6736bc0bc","publisherDisplayName":"AbelMak","targetPlatform":"universal","updated":true,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"preRelease":false,"size":691228},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"szlk.solodrop","uuid":"89164449-ceef-401d-8366-dc70e9e09776"},"manifest":{"name":"solodrop","displayName":"SoloDrop - Share Agent Artifacts","description":"Turn agent-made files into verified browser previews and share them in one click. / 将 Agent 生成的文件转成已验证的网页预览，一键分享。","version":"0.0.31","publisher":"SZLK","license":"MIT","icon":"resources/logo.png","repository":{"type":"git","url":"https://github.com/jobssteve164dev/solodrop.git"},"engines":{"vscode":"^1.85.0"},"categories":["Visualization","Other"],"keywords":["agent","artifact"