ore File","category":"SoloSync"},{"command":"solosync.verifySnapshot","title":"SoloSync: Verify Snapshot","category":"SoloSync"},{"command":"solosync.refresh","title":"SoloSync: Refresh History","category":"SoloSync","icon":"$(refresh)"}],"viewsContainers":{"activitybar":[{"id":"solosync","title":"SoloSync","icon":"resources/activitybar.svg"}]},"views":{"solosync":[{"id":"solosync.history","name":"Backup History"}]},"viewsWelcome":[{"view":"solosync.history","contents":"Choose the project folder SoloSync should protect.\n[Choose Project Folder](command:solosync.configureSource)","when":"!solosync.hasSourceDirectory"},{"view":"solosync.history","contents":"The selected project folder is unavailable.\n[Choose Another Project Folder](command:solosync.configureSource)","when":"solosync.hasSourceDirectory && !solosync.sourceDirectoryAvailable"},{"view":"solosync.history","contents":"Choose where SoloSync should store backups.\n[Set Backup Location](command:solosync.configure)","when":"solosync.hasSourceDirectory && solosync.sourceDirectoryAvailable && !solosync.hasBackupLocation"},{"view":"solosync.history","contents":"The backup location is unavailable. Reconnect it or choose another folder.\n[Choose Another Location](command:solosync.configure)","when":"solosync.hasSourceDirectory && solosync.sourceDirectoryAvailable && solosync.hasBackupLocation && !solosync.backupLocationAvailable"},{"view":"solosync.history","contents":"SoloSync is ready.\n[Create First Backup](command:solosync.backupNow)\n[Change Setup](command:solosync.setup)","when":"solosync.hasSourceDirectory && solosync.sourceDirectoryAvailable && solosync.hasBackupLocation && solosync.backupLocationAvailable"}],"menus":{"view/title":[{"command":"solosync.setup","when":"view == solosync.history","group":"navigation@1"},{"command":"solosync.backupNow","when":"view == solosync.history && !solosync.backupRunning","group":"navigation@2"},{"command":"solosync.cancelBackup","when":"view == solosync.history && solosy