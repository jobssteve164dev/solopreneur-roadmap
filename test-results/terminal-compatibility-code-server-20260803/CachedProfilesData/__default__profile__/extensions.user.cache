5.0","typescript":"^5.7.0","wrangler":"^4.112.0"}},"location":{"$mid":1,"path":"/home/ubuntu/.local/share/code-server/extensions/szlk.solodrop-0.0.31-universal","scheme":"file"},"isBuiltin":false,"targetPlatform":"universal","publisherDisplayName":"SZLK","metadata":{"isApplicationScoped":false,"isMachineScoped":false,"isBuiltin":false,"installedTimestamp":1784428399020,"pinned":false,"source":"gallery","id":"89164449-ceef-401d-8366-dc70e9e09776","publisherId":"29949b98-4cec-4f03-a2e4-81e0defba808","publisherDisplayName":"SZLK","targetPlatform":"universal","updated":true,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"preRelease":false,"size":147739},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"szlk.solobrowser","uuid":"d04fa56f-5619-4358-89a0-4d8c1428e2ed"},"manifest":{"name":"solobrowser","displayName":"SoloBrowser","description":"A real, visible browser in VS Code for local AI agents and everyday web tasks.","version":"0.1.3","publisher":"SZLK","icon":"icon.png","license":"MIT","private":false,"engines":{"vscode":"^1.95.0"},"categories":["Testing","Visualization","Other"],"keywords":["agent","browser","mcp","automation","vscode","webview","screencast","mjpeg","playwright","puppeteer"],"repository":{"type":"git","url":"https://github.com/jobssteve164dev/bmcp.git"},"homepage":"https://github.com/jobssteve164dev/bmcp#readme","bugs":{"url":"https://github.com/jobssteve164dev/bmcp/issues"},"main":"./src/extension.js","extensionKind":["workspace"],"capabilities":{"untrustedWorkspaces":{"supported":true}},"activationEvents":["*","onStartupFinished","onCommand:bmcp.openBrowser","onCommand:bmcp.runDemo"],"contributes":{"commands":[{"command":"bmcp.openBrowser","title":"SoloBrowser: Open Browser"},{"command":"bmcp.runDemo","title":"SoloBrowser: Run Demo"}],"viewsContainers":{"activitybar":[{"id":"bmcp-explorer","title":"SoloBrowser","icon":"$(globe)"}]},"views":{"bmcp-explorer":[{"type":"webview","id":"bmcp.browserView","name":"SoloBrowser"}]},"configuration":{"title":"SoloBrowser","properties":{"bmcp.port":{"type":"number","default":17333,"description":"Local HTTP port used by local AI agents to control SoloBrowser."},"bmcp.browserPath":{"type":"string","default":"","description":"Optional path to a stable Chrome, Edge, or Chromium installation used by SoloBrowser."}}}},"scripts":{"check":"node --check src/extension.js && node --check src/browserRuntime.js && node --check src/pageModel.js && node --check scripts/smoke-http.js","test":"node test/pageModel.test.js && node test/sidebarView.test.js && node test/browserRuntime.test.js","package":"vsce package --allow-star-activation","publish:marketplace":"vsce publish --allow-star-activation -p $VSCE_PAT","smoke:http":"node scripts/smoke-http.js","verify":"npm run check && npm test && npm run package"},"devDependencies":{"@vscode/vsce":"^3.2.2","jsdom":"^25.0.1"},"dependencies":{"extract-zip":"^2.0.1","ws":"^8.21.0"}},"location":{"$mid":1,"path":"/home/ubuntu/.local/share/code-server/extensions/szlk.solobrowser-0.1.3-universal","scheme":"file"},"isBuiltin":false,"targetPlatform":"universal","publisherDisplayName":"SZLK","metadata":{"isApplicationScoped":false,"isMachineScoped":false,"isBuiltin":false,"installedTimestamp":1784500389451,"pinned":false,"source":"gallery","id":"d04fa56f-5619-4358-89a0-4d8c1428e2ed","publisherId":"29949b98-4cec-4f03-a2e4-81e0defba808","publisherDisplayName":"SZLK","targetPlatform":"universal","updated":true,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"preRelease":false,"size":1155407},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"openai.chatgpt","uuid":"90b52117-6fd1-4f1c-9e14-256bd6e21d79"},"manifest":{"name":"chatgpt","publisher":"openai","version":"26.721.30844","displayName":"Codex – OpenAI’s coding agent","description":"Codex is a coding agent that works with you everywhere you code — included in ChatGPT Plus, Pro, Business, Edu, and Enterprise plans.","license":"SEE LICENSE IN LICENSE.md","engines":{"vscode":"^1.96.2"},"categories":["AI","Chat"],"keywords":["codex","openai","chatgpt","ai","agent","coding","code","chat"],"activationEvents":["onStartupFinished","onUri"],"main":"./out/extension.js","enabledApiProposals":["chatSessionsProvider","languageModelProxy"],"icon":"resources/blossom.dark.png","//":"Codex command contributions in contributes.commands/keybindings and canonical setting contributions in contributes.configuration are generated and checked in for extension dev; run the matching pnpm --dir extension ...:fix script after editing them.","contributes":{"commands":[{"command":"chatgpt.implementTodo","title":"Implement with Codex","category":"Codex","enablement":"false"},{"command":"chatgpt.openSidebar","title":"Open Codex Sidebar","category":"Codex","icon":{"light":"resources/blossom-black.svg","dark":"resources/blossom-white.svg"}},{"command":"chatgpt.openCommandMenu","title":"Open Codex Command Menu","category":"Codex"},{"command":"chatgpt.newCodexPanel","title":"New Codex Agent","category":"Codex","icon":"$(plus)"},{"command":"chatgpt.addToThread","title":"Add to Codex Thread","category":"Codex"},{"command":"chatgpt.addFileToThread","title":"Add File to Codex Thread","category":"Codex"},{"command":"chatgpt.newChat","title":"New Chat in ChatGPT Sidebar","category":"Codex"},{"command":"chatgpt.showLspMcpCliArgs","title":"Copy Codex CLI args for LSP MCP","category":"Codex"},{"command":"chatgpt.dumpNuxState","title":"Debug: print NUX state to console","category":"Codex","enablement":"chatgpt.sidebarView.visible"},{"command":"chatgpt.resetNuxState","title":"Debug: reset NUX state","category":"Codex","enablement":"chatgpt.sidebarView.visible"}],"keybindings":[{"command":"chatgpt.newChat","key":"ctrl+n","mac":"cmd+n","when":"chatgpt.supportsNewChatKeyShortcut"}],"configuration":{"type":"object","title":"Codex Settings","properties":{"chatgpt.commentCodeLensEnabled":{"description":"Enable CodeLens above TODO comments to implement with Codex.","type":"boolean","default":true},"chatgpt.cliExecutable":{"description":"DEVELOPMENT ONLY: Path to the Codex CLI executable. You do NOT need to set this unless you are actively developing the Codex CLI. If set this manually, parts of the extension may not work as expected.","type":["string","null"],"default":null,"scope":"application","restricted":true},"chatgpt.openOnStartup":{"description":"Focus the Codex sidebar when the extension finishes starting up.","type":"boolean","default":false},"chatgpt.followUpQueueMode":{"description":"Control whether follow-up messages are queued or steer the current run. Press Cmd/Ctrl+Shift+Enter to do the opposite for a single in-progress follow-up.","type":"string","enum":["queue","steer","interrupt"],"default":"queue"},"chatgpt.composerEnterBehavior":{"description":"Enter behavior for the Codex composer.","type":"string","enum":["enter","cmdIfMultiline","cmdAlways"],"default":"enter"},"chatgpt.reviewDelivery":{"description":"Start /review inline in the current chat when possible or launch a separate review chat","type":"string","enum":["inline","detached"],"default":"inline"},"chatgpt.localeOverride":{"description":"Preferred language for the Codex UI. Leave empty to auto detect.","type":["string","null"],"default":null,"scope":"application"},"chatgpt.runCodexInWindowsSubsystemForLinux":{"description":"Windows only: when Windows Subsystem for Linux (WSL) is installed, automatically run Codex inside WSL. Recommended for improved sandbox security and better performance - Agent mode on Windows currently requires WSL. Changing this setting reloads VS Code to take effect.","type":"boolean","default":false}}},"viewsContainers":{"activitybar":[{"id":"codexViewContainer","title":"Codex","icon":"resources/blossom-white.svg","when":"chatgpt.doesNotSupportSecondarySidebar"}],"secondarySidebar":[{"id":"codexSecondaryViewContainer","