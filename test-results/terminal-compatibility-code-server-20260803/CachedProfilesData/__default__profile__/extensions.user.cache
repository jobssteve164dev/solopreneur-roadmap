":["onView:solopreneur.sidebar","onCommand:solopreneur.showRoadmap","onCommand:solopreneur.showStrategyPyramid","onCommand:solopreneur.refreshProjectGrowthData","onUri"],"main":"./out/extension.js","contributes":{"commands":[{"command":"solopreneur.showRoadmap","title":"SoloMap: Show AI Roadmap","category":"SoloMap"},{"command":"solopreneur.showStrategyPyramid","title":"SoloMap: Show Strategy Pyramid","category":"SoloMap"},{"command":"solopreneur.refreshProjectGrowthData","title":"SoloMap: Refresh Project Growth Data","category":"SoloMap"}],"viewsContainers":{"activitybar":[{"id":"solopreneur-sidebar-container","title":"SoloMap","icon":"resources/activitybar.svg"}]},"views":{"solopreneur-sidebar-container":[{"type":"webview","id":"solopreneur.sidebar","name":"SoloMap"}]},"configuration":{"title":"SoloMap Settings","properties":{"solopreneur.cliPath":{"type":"string","default":"agy","description":"The command name or absolute path of your local Agent CLI executable, such as agy, codex, claude, or opencode."},"solopreneur.language":{"type":"string","default":"zh","enum":["zh","en"],"description":"The display language used by SoloMap webviews."},"solopreneur.globalPrompt":{"type":"string","default":"","description":"Default instructions injected into every SoloMap Agent task conversation."},"solopreneur.globalDataPath":{"type":"string","default":"","description":"Directory path used for SoloMap cross-project data. SoloMap stores .solomap-global data here; if a parent directory is provided, .solomap-global is created inside it."},"solopreneur.reviewerCliPath":{"type":"string","default":"","description":"Optional secondary Agent CLI used for read-only review after task runs. If empty, SoloMap uses the main Agent CLI."},"solopreneur.collaborationReviewMode":{"type":"string","default":"high_risk","enum":["off","high_risk","all"],"description":"Controls when SoloMap runs a secondary read-only Agent review after a task run."},"solopreneur.automationTasks":{"type":"object","d