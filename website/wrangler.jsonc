{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "solomap-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "solomap.app",
      "custom_domain": true
    },
    {
      "pattern": "www.solomap.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "analytics_engine_datasets": [
    {
      "binding": "SITE_ANALYTICS",
      "dataset": "solomap_site_events"
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://solomap.app"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLABORATION_ROOMS",
        "class_name": "CollaborationRoom"
      },
      {
        "name": "COLLABORATION_QUOTAS",
        "class_name": "CollaborationQuota"
      },
      {
        "name": "COLLABORATION_GLOBAL_QUOTA",
        "class_name": "CollaborationQuota"
      },
      {
        "name": "COLLABORATION_LOBBY",
        "class_name": "CollaborationLobby"
      }
    ]
  },
  "migrations": [
    {
      "tag": "collaboration-rooms-v1",
      "new_sqlite_classes": [
        "CollaborationRoom"
      ]
    },
    {
      "tag": "collaboration-quotas-v1",
      "new_sqlite_classes": [
        "CollaborationQuota"
      ]
    },
    {
      "tag": "collaboration-lobby-v1",
      "new_sqlite_classes": [
        "CollaborationLobby"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "COLLABORATION_DEVICE_REGISTRATION_LIMITER",
      "namespace_id": "21001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "COLLABORATION_ROOM_CREATE_LIMITER",
      "namespace_id": "21002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "COLLABORATION_LOBBY_JOIN_LIMITER",
      "namespace_id": "21003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
