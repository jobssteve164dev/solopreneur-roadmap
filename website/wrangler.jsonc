{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "solomap-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "solomap.app",
      "custom_domain": true
    },
    {
      "pattern": "www.solomap.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SITE_ORIGIN": "https://solomap.app"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLABORATION_ROOMS",
        "class_name": "CollaborationRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "collaboration-rooms-v1",
      "new_sqlite_classes": [
        "CollaborationRoom"
      ]
    }
  ]
}
